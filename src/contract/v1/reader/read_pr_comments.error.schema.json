{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/reader/read_pr_comments.error.schema.json",
  "title": "ReadPRCommentsError",
  "description": "reader のゲートが止まったときのエラー応答。コメント本文は含めない。details.comments は、止めたコメントの種別・ID・投稿者・URL だけ。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "error"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "UNTRUSTED_COMMENT",
            "AUTHOR_CHECK_FAILED",
            "TRUSTED_AUTHORS_NOT_CONFIGURED",
            "PROJECT_ALLOWLIST_INVALID",
            "SNAPSHOT_CHANGED"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comments"],
          "properties": {
            "comments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "id", "author", "authorType", "url"],
                "properties": {
                  "kind": { "enum": ["review_thread_comment", "review_body", "issue_comment"] },
                  "id": { "type": "string", "pattern": "^[0-9]+$" },
                  "threadId": { "type": "string", "minLength": 1 },
                  "author": { "type": "string" },
                  "authorType": { "type": "string" },
                  "url": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
