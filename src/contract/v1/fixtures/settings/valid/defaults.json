{
  "schemaVersion": 1,
  "retention": {
    "finishedRequestDays": 30,
    "idempotencyDays": 30,
    "cancellationRecordDays": 30,
    "resultIndexDays": 30
  },
  "delivery": {
    "maxAttempts": 8,
    "initialBackoffMs": 1000,
    "backoffMultiplier": 2,
    "maxBackoffMs": 60000,
    "jitterRatio": 0.2,
    "retryOn": [
      "network",
      "http5xx"
    ]
  },
  "observation": {
    "heartbeatSeconds": 60,
    "staleAfterSeconds": 180,
    "clockSkewToleranceSeconds": 30
  }
}
