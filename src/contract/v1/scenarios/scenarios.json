[
  {
    "id": "idempotent-resend-and-conflict",
    "description": "同じ key・同じ payload の再送は同じ cycle を返す。同じ key で HEAD だけ変えると競合し、副作用を起こさない。",
    "covers": "同key・同payloadを再送／同keyでHEADだけ変更",
    "steps": [
      {
        "actor": "agent",
        "op": "request_review",
        "input": {
          "schemaVersion": 1,
          "owner": "scottlz0310",
          "repo": "mcp-resource-subscriber",
          "prNumber": 226,
          "expectedHeadSha": "0123456789abcdef0123456789abcdef01234567",
          "reason": "opened",
          "idempotencyKey": "agent-req-0001"
        },
        "expect": {
          "output": {
            "schemaVersion": 1,
            "cycleId": "cyc_01jbq3x8n5r7t9v2w4y6z8a0c1",
            "round": 1,
            "headSha": "0123456789abcdef0123456789abcdef01234567",
            "dispatch": "pending",
            "resourceUri": "review-raven://requests/cyc_01jbq3x8n5r7t9v2w4y6z8a0c1",
            "snapshotRevision": 1,
            "deduplicated": false
          }
        }
      },
      {
        "actor": "agent",
        "op": "request_review",
        "input": {
          "schemaVersion": 1,
          "owner": "scottlz0310",
          "repo": "mcp-resource-subscriber",
          "prNumber": 226,
          "expectedHeadSha": "0123456789abcdef0123456789abcdef01234567",
          "reason": "opened",
          "idempotencyKey": "agent-req-0001"
        },
        "expect": {
          "output": {
            "schemaVersion": 1,
            "cycleId": "cyc_01jbq3x8n5r7t9v2w4y6z8a0c1",
            "round": 1,
            "headSha": "0123456789abcdef0123456789abcdef01234567",
            "dispatch": "pending",
            "resourceUri": "review-raven://requests/cyc_01jbq3x8n5r7t9v2w4y6z8a0c1",
            "snapshotRevision": 1,
            "deduplicated": true
          }
        }
      },
      {
        "actor": "agent",
        "op": "request_review",
        "input": {
          "schemaVersion": 1,
          "owner": "scottlz0310",
          "repo": "mcp-resource-subscriber",
          "prNumber": 226,
          "expectedHeadSha": "89abcdef0123456789abcdef0123456789abcdef",
          "reason": "opened",
          "idempotencyKey": "agent-req-0001"
        },
        "expect": {
          "error": "IDEMPOTENCY_CONFLICT"
        }
      },
      {
        "actor": "agent",
        "op": "get_review_request",
        "input": {
          "schemaVersion": 1,
          "cycleId": "cyc_01jbq3x8n5r7t9v2w4y6z8a0c1"
        },
        "expect": {
          "snapshot": {
            "round": 1,
            "snapshotRevision": 1,
            "dispatch.state": "pending",
            "terminal": false
          }
        }
      }
    ]
  },
  {
    "id": "head-conflict-and-invalid-argument",
    "description": "expectedHeadSha が現在の PR HEAD と異なる依頼は HEAD_CONFLICT。書式違反は受付前に INVALID_ARGUMENT。",
    "covers": "HEAD競合・入力検証",
    "steps": [
      {
        "event": "PR の現在 HEAD は HA"
      },
      {
        "actor": "agent",
        "op": "request_review",
        "input": {
          "schemaVersion": 1,
          "owner": "scottlz0310",
          "repo": "mcp-resource-subscriber",
          "prNumber": 226,
          "expectedHeadSha": "89abcdef0123456789abcdef0123456789abcdef",
          "reason": "opened",
          "idempotencyKey": "agent-req-0002"
        },
        "expect": {
          "error": "HEAD_CONFLICT"
        }
      },
      {
        "actor": "agent",
        "op": "request_review",
        "input": {
          "schemaVersion": 1,
          "owner": "scottlz0310",
          "repo": "mcp-resource-subscriber",
          "prNumber": 226,
          "expectedHeadSha": "abc123",
          "reason": "opened",
          "idempotencyKey": "agent-req-0002"
        },
        "expect": {
          "error": "INVALID_ARGUMENT"
        }
      }
    ]
  },
