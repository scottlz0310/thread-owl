  {
    "id": "not-found-and-expired",
    "description": "未知の cycle は REQUEST_NOT_FOUND。保持期限後は URI を別 cycle に再利用せず REQUEST_EXPIRED。",
    "covers": "30日保持・失効URI",
    "steps": [
      {
        "actor": "agent",
        "op": "get_review_request",
        "input": {
          "schemaVersion": 1,
          "cycleId": "cyc_01jbq3x8n5r7t9v2w4y6z8a0c2"
        },
        "expect": {
          "error": "REQUEST_NOT_FOUND"
        }
      },
      {
        "event": "CYC1 は完了後 30 日を超えて削除された"
      },
      {
        "actor": "agent",
        "op": "get_review_request",
        "input": {
          "schemaVersion": 1,
          "cycleId": "cyc_01jbq3x8n5r7t9v2w4y6z8a0c1"
        },
        "expect": {
          "error": "REQUEST_EXPIRED"
        }
      }
    ]
  },
