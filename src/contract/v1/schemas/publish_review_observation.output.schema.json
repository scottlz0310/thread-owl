{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/publish_review_observation.output.schema.json",
  "title": "PublishReviewObservationOutput",
  "description": "applied=反映、duplicate=同一 sequence・同一内容の冪等 ACK。遅着・旧 epoch・同一 sequence で内容違い・割当外はエラー code を返し、現状態を変更しない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "result",
    "snapshotRevision"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "result": {
      "enum": [
        "applied",
        "duplicate"
      ]
    },
    "snapshotRevision": {
      "$ref": "common.schema.json#/$defs/revision"
    }
  }
}
