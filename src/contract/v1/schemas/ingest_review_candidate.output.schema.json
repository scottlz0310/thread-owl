{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/ingest_review_candidate.output.schema.json",
  "title": "IngestReviewCandidateOutput",
  "description": "受付結果。同一 sourceId、または同一 PR/HEAD/reason の未完了依頼は既存 cycle を返す（deduplicated=true）。取消済み cycle の旧 sourceId は旧 cycle を返し、新 round を作らない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cycleId",
    "round",
    "dispatch",
    "resourceUri",
    "deduplicated"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "cycleId": {
      "$ref": "common.schema.json#/$defs/cycleId"
    },
    "round": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "dispatch": {
      "$ref": "common.schema.json#/$defs/dispatchState"
    },
    "resourceUri": {
      "$ref": "common.schema.json#/$defs/requestUri"
    },
    "deduplicated": {
      "type": "boolean"
    }
  }
}
