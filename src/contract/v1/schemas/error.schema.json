{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/error.schema.json",
  "title": "ErrorEnvelope",
  "description": "すべての公開・内部 tool のエラー応答。認証・権限・schema 競合は自動で迂回せず構造化して返す。retryable=true は ACK 未受信のネットワーク・5xx 相当だけ。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
