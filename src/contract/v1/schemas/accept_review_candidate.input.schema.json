{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/accept_review_candidate.input.schema.json",
  "title": "AcceptReviewCandidateInput",
  "description": "raven → owl。cycleId/round/HEAD を固定して候補を渡す。owl は PR origin を再検証し、永続受理記録・重複判定の後に queue へ載せる。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cycleId",
    "round",
    "owner",
    "repo",
    "prNumber",
    "headSha",
    "reason",
    "sourceId"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "cycleId": {
      "$ref": "common.schema.json#/$defs/cycleId"
    },
    "round": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/owner"
    },
    "repo": {
      "$ref": "common.schema.json#/$defs/repo"
    },
    "prNumber": {
      "$ref": "common.schema.json#/$defs/prNumber"
    },
    "headSha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/reason"
    },
    "sourceId": {
      "$ref": "common.schema.json#/$defs/sourceIdOrNull"
    }
  }
}
