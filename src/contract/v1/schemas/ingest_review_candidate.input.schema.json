{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/ingest_review_candidate.input.schema.json",
  "title": "IngestReviewCandidateInput",
  "description": "owl → raven。owl が署名・origin を検証した webhook イベント。sourceId（deliveryId/コメント ID 等）で手動経路と結合する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "owner",
    "repo",
    "prNumber",
    "headSha",
    "reason",
    "delivery"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "sourceId": {
      "$ref": "common.schema.json#/$defs/sourceId"
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/owner"
    },
    "repo": {
      "$ref": "common.schema.json#/$defs/repo"
    },
    "prNumber": {
      "$ref": "common.schema.json#/$defs/prNumber"
    },
    "headSha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/reason"
    },
    "delivery": {
      "enum": [
        "webhook",
        "comment"
      ]
    }
  }
}
