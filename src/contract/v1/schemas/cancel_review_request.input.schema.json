{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/cancel_review_request.input.schema.json",
  "title": "CancelReviewRequestInput",
  "description": "結果なし失敗 cycle からの復旧入口。元の依頼主体、または保護設定で当該 repo の取消を許可された運用主体だけが呼べる。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cycleId",
    "expectedHeadSha",
    "expectedSnapshotRevision",
    "idempotencyKey"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "cycleId": {
      "$ref": "common.schema.json#/$defs/cycleId"
    },
    "expectedHeadSha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "expectedSnapshotRevision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "idempotencyKey": {
      "$ref": "common.schema.json#/$defs/idempotencyKey"
    }
  }
}
