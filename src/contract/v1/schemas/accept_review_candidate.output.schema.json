{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/accept_review_candidate.output.schema.json",
  "title": "AcceptReviewCandidateOutput",
  "description": "受理結果。duplicate=true は同一 cycleId/round/HEAD の再送で、queue へ二重に載せていない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "duplicate"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "candidateId": {
      "$ref": "common.schema.json#/$defs/candidateId"
    },
    "duplicate": {
      "type": "boolean"
    }
  }
}
