{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/cancel_review_candidate.input.schema.json",
  "title": "CancelReviewCandidateInput",
  "description": "raven → owl。旧候補の起動権・結果投稿権を永続的に無効化する。未受理 cycle にも取消記録を残し、遅着する受付を拒否する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cycleId",
    "round",
    "headSha",
    "cancelId"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "cycleId": {
      "$ref": "common.schema.json#/$defs/cycleId"
    },
    "round": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "headSha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "cancelId": {
      "$ref": "common.schema.json#/$defs/cancelId"
    }
  }
}
