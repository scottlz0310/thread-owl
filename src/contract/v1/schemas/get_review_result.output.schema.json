{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/get_review_result.output.schema.json",
  "title": "GetReviewResultOutput",
  "description": "結果参照。未投稿なら result=null。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/reviewResult"
        }
      ]
    }
  }
}
