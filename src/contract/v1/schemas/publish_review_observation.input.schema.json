{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/publish_review_observation.input.schema.json",
  "title": "PublishReviewObservationInput",
  "description": "Squirrel → raven。状態変化時と 60 秒 heartbeat で送る。許可項目だけを受理し、ローカルパス・コマンドライン・ログ本文・秘密値は含めない。producerEpoch は producer 再起動ごとに増加し、より大きい epoch を受けると旧 epoch を失効させる。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cycleId",
    "candidateId",
    "headSha",
    "producerId",
    "producerEpoch",
    "sequence",
    "observedAt",
    "state",
    "holdReason",
    "outcome",
    "exitCode",
    "stopped"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "cycleId": {
      "$ref": "common.schema.json#/$defs/cycleId"
    },
    "candidateId": {
      "$ref": "common.schema.json#/$defs/candidateId"
    },
    "headSha": {
      "$ref": "common.schema.json#/$defs/sha"
    },
    "producerId": {
      "$ref": "common.schema.json#/$defs/producerId"
    },
    "producerEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "state": {
      "enum": [
        "waiting",
        "running",
        "finished"
      ]
    },
    "holdReason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "ciPending",
            "busy",
            "manual",
            "autoPause"
          ]
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "completed",
            "failed"
          ]
        }
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer"
        }
      ]
    },
    "stopped": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "description": "holdReason は waiting のときだけ。outcome/exitCode は finished のときだけ。",
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "waiting"
            },
            "outcome": {
              "type": "null"
            },
            "exitCode": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "running"
            },
            "holdReason": {
              "type": "null"
            },
            "outcome": {
              "type": "null"
            },
            "exitCode": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "finished"
            },
            "holdReason": {
              "type": "null"
            }
          }
        }
      ]
    }
  ]
}
