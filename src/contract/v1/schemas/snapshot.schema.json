{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.review-raven.example/contracts/v1/snapshot.schema.json",
  "title": "ReviewRequestSnapshot",
  "description": "get_review_request の出力、および review-raven://requests/{cycleId} の resource 内容。依頼正本・結果参照・観測から再構築できる射影であり、結果本文や Verdict の複製は持たない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cycleId",
    "owner",
    "repo",
    "prNumber",
    "expectedHeadSha",
    "round",
    "dispatch",
    "cancellation",
    "execution",
    "result",
    "terminal",
    "terminalReason",
    "supersededBy",
    "snapshotRevision",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "cycleId": { "$ref": "common.schema.json#/$defs/cycleId" },
    "owner": { "$ref": "common.schema.json#/$defs/owner" },
    "repo": { "$ref": "common.schema.json#/$defs/repo" },
    "prNumber": { "$ref": "common.schema.json#/$defs/prNumber" },
    "expectedHeadSha": { "$ref": "common.schema.json#/$defs/sha" },
    "round": { "$ref": "common.schema.json#/$defs/revision" },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "candidateId", "attempts", "errorCode"],
      "properties": {
        "state": { "$ref": "common.schema.json#/$defs/dispatchState" },
        "candidateId": { "$ref": "common.schema.json#/$defs/candidateIdOrNull" },
        "attempts": { "type": "integer", "minimum": 0 },
        "errorCode": { "$ref": "common.schema.json#/$defs/errorCodeOrNull" }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "cancelId", "requestedAt", "confirmedAt", "errorCode"],
      "properties": {
        "state": { "enum": ["none", "requested", "confirmed"] },
        "cancelId": { "$ref": "common.schema.json#/$defs/cancelIdOrNull" },
        "requestedAt": { "$ref": "common.schema.json#/$defs/timestampOrNull" },
        "confirmedAt": { "$ref": "common.schema.json#/$defs/timestampOrNull" },
        "errorCode": { "$ref": "common.schema.json#/$defs/errorCodeOrNull" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "holdReason",
        "producerId",
        "producerEpoch",
        "sequence",
        "observedAt",
        "receivedAt",
        "freshness",
        "outcome",
        "exitCode"
      ],
      "properties": {
        "state": { "enum": ["unknown", "waiting", "running", "finished"] },
        "holdReason": {
          "anyOf": [{ "type": "null" }, { "enum": ["ciPending", "busy", "manual", "autoPause"] }]
        },
        "producerId": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/producerId" }] },
        "producerEpoch": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "sequence": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
        "observedAt": { "$ref": "common.schema.json#/$defs/timestampOrNull" },
        "receivedAt": { "$ref": "common.schema.json#/$defs/timestampOrNull" },
        "freshness": { "enum": ["unknown", "fresh", "stale", "stopped"] },
        "outcome": { "anyOf": [{ "type": "null" }, { "enum": ["completed", "failed"] }] },
        "exitCode": { "anyOf": [{ "type": "null" }, { "type": "integer" }] }
      }
    },
    "result": { "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/reviewResult" }] },
    "terminal": { "type": "boolean" },
    "terminalReason": { "anyOf": [{ "type": "null" }, { "enum": ["result", "superseded", "cancelled"] }] },
    "supersededBy": { "$ref": "common.schema.json#/$defs/cycleIdOrNull" },
    "snapshotRevision": { "$ref": "common.schema.json#/$defs/revision" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "description": "dispatch=failed は原因 code を返す。accepted は candidateId を持つ。pending は candidateId を持たない。",
      "oneOf": [
        {
          "properties": {
            "dispatch": {
              "properties": {
                "state": { "const": "pending" },
                "candidateId": { "type": "null" }
              }
            }
          }
        },
        {
          "properties": {
            "dispatch": {
              "properties": {
                "state": { "const": "accepted" },
                "candidateId": { "$ref": "common.schema.json#/$defs/candidateId" },
                "errorCode": { "type": "null" }
              }
            }
          }
        },
        {
          "properties": {
            "dispatch": {
              "properties": {
                "state": { "const": "failed" },
                "errorCode": { "$ref": "common.schema.json#/$defs/errorCode" }
              }
            }
          }
        }
      ]
    },
    {
      "description": "cancellation=none は cancelId を持たない。confirmed は confirmedAt を持つ。",
      "oneOf": [
        {
          "properties": {
            "cancellation": {
              "properties": {
                "state": { "const": "none" },
                "cancelId": { "type": "null" },
                "requestedAt": { "type": "null" },
                "confirmedAt": { "type": "null" }
              }
            }
          }
        },
        {
          "properties": {
            "cancellation": {
              "properties": {
                "state": { "const": "requested" },
                "cancelId": { "$ref": "common.schema.json#/$defs/cancelId" },
                "requestedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
                "confirmedAt": { "type": "null" }
              }
            }
          }
        },
        {
          "properties": {
            "cancellation": {
              "properties": {
                "state": { "const": "confirmed" },
                "cancelId": { "$ref": "common.schema.json#/$defs/cancelId" },
                "requestedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
                "confirmedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
                "errorCode": { "type": "null" }
              }
            }
          }
        }
      ]
    },
    {
      "description": "execution: 観測なし(unknown)は freshness=unknown。holdReason は waiting のときだけ。outcome/exitCode は finished のときだけ。",
      "oneOf": [
        {
          "properties": {
            "execution": {
              "properties": {
                "state": { "const": "unknown" },
                "freshness": { "const": "unknown" },
                "holdReason": { "type": "null" },
                "producerId": { "type": "null" },
                "outcome": { "type": "null" },
                "exitCode": { "type": "null" }
              }
            }
          }
        },
        {
          "properties": {
            "execution": {
              "properties": {
                "state": { "const": "waiting" },
                "producerId": { "$ref": "common.schema.json#/$defs/producerId" },
                "freshness": { "enum": ["fresh", "stale", "stopped"] },
                "outcome": { "type": "null" },
                "exitCode": { "type": "null" }
              }
            }
          }
        },
        {
          "properties": {
            "execution": {
              "properties": {
                "state": { "const": "running" },
                "producerId": { "$ref": "common.schema.json#/$defs/producerId" },
                "freshness": { "enum": ["fresh", "stale", "stopped"] },
                "holdReason": { "type": "null" },
                "outcome": { "type": "null" },
                "exitCode": { "type": "null" }
              }
            }
          }
        },
        {
          "properties": {
            "execution": {
              "properties": {
                "state": { "const": "finished" },
                "producerId": { "$ref": "common.schema.json#/$defs/producerId" },
                "freshness": { "enum": ["fresh", "stale", "stopped"] },
                "holdReason": { "type": "null" }
              }
            }
          }
        }
      ]
    },
    {
      "description": "terminal は terminalReason と対応する。result=結果参照あり、cancelled=取消確定（結果は持たない）、superseded=後続 cycle あり（遅着した旧 cycle の結果参照は保持できる）。非終端は result を持たず、取消は none / requested だけ。プロセス終了・観測停止・配送失敗だけでは terminal にならない。",
      "oneOf": [
        {
          "properties": {
            "terminal": { "const": false },
            "terminalReason": { "type": "null" },
            "supersededBy": { "type": "null" },
            "result": { "type": "null" },
            "cancellation": { "properties": { "state": { "enum": ["none", "requested"] } } }
          }
        },
        {
          "properties": {
            "terminal": { "const": true },
            "terminalReason": { "const": "result" },
            "supersededBy": { "type": "null" },
            "result": { "$ref": "common.schema.json#/$defs/reviewResult" }
          }
        },
        {
          "properties": {
            "terminal": { "const": true },
            "terminalReason": { "const": "cancelled" },
            "supersededBy": { "type": "null" },
            "result": { "type": "null" },
            "cancellation": { "properties": { "state": { "const": "confirmed" } } }
          }
        },
        {
          "properties": {
            "terminal": { "const": true },
            "terminalReason": { "const": "superseded" },
            "supersededBy": { "$ref": "common.schema.json#/$defs/cycleId" }
          }
        }
      ]
    }
  ]
}
