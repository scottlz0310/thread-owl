# GitHub App の App ID（GitHub App 設定ページで確認）
GITHUB_APP_ID=

# GitHub App の秘密鍵（PEM）。以下のいずれか1つを設定する。
# 解決の優先順位は FILE > B64 > raw。
#
# 推奨1（ローカル開発）: .pem のファイルパスを指定する。
#   置場の推奨は ~/.config/thread-owl/（Windows: %USERPROFILE%\.config\thread-owl\）。
#   リポジトリ外に置くことで誤コミット・同期流出を構造的に防ぐ。
# GITHUB_APP_PRIVATE_KEY_FILE=C:\Users\<you>\.config\thread-owl\github-app.pem
#
# 推奨2（Bitwarden / dsx 注入）: .pem を base64 化した1行 secret。改行・スペース変換に強い。
#   生成: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content -Raw .\github-app.pem)))
# GITHUB_APP_PRIVATE_KEY_B64=
#
# 後方互換（脆弱）: 改行を \n でエスケープして一行で設定する。
#   注入過程で \n がスペース化されると createPrivateKey が失敗するため非推奨。
#   例: "-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_PRIVATE_KEY=

# GitHub App のスラッグ（GitHub App の URL: github.com/apps/<slug>）
# 自 App が作成したイベントのループ防止に使用する（デフォルト: thread-owl）
APP_SLUG=thread-owl

# Webhook 署名検証用シークレット（GitHub App 設定で設定した値）
GITHUB_WEBHOOK_SECRET=

# 操作対象リポジトリ（カンマ区切り owner/repo 形式。空の場合は全 write 拒否）
ALLOWED_REPOS=owner/repo1,owner/repo2

# PR の作成者として信頼する GitHub の login（カンマ区切り。bot は `name` でも `name[bot]` でもよい）。
# 設定すると、許可された作成者の同一リポジトリの PR だけを queue に載せる（fork からの PR は常に拒否）。
# webhook の再レビュー依頼（@thread-owl のコメント）は、投稿者が許可され、かつ PR の作成者が許可された同一リポジトリの PR である必要がある。
# 再レビューを依頼する bot 名義（例: mcp-gateway-authentication-app）も含めること。
# 必須。未設定（空）の間は、すべての PR と再レビュー依頼を拒否する（fail-closed。ALLOWED_REPOS が空のときと同じ）。
ALLOWED_AUTHORS=your-login,mcp-gateway-authentication-app

# HTTP サーバーのポート（デフォルト: 3000）
PORT=3000

# HTTP サーバーの bind アドレス（デフォルト: 127.0.0.1。外部公開する場合は別途認証が必要）
HOST=127.0.0.1

# review-raven との内部面（任意。3 つを同時に設定する。--mcp-http / --webhook-mcp-http のみ）
# THREAD_OWL_LEDGER_PATH=/data/ledger.sqlite
# THREAD_OWL_INTERNAL_PROXY_SECRET=<gateway と共有する 16 文字以上の secret>
# THREAD_OWL_SERVICE_ACL={"services":{"svc-raven":{"actions":["accept","cancel","get_result"],"repos":["your-org/*"]}}}

# 結果を review-raven へ送る（任意。上の内部面の設定が前提。2 つを同時に設定する）
# THREAD_OWL_RAVEN_INTERNAL_URL=https://gateway.example/mcp/raven-internal
# THREAD_OWL_RAVEN_INTERNAL_TOKEN=<review-raven 用に発行したサービス資格情報>

# ログレベル: trace | debug | info | warn | error（デフォルト: info）
LOG_LEVEL=info
